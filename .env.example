# Copy to .env and adjust as needed. Loaded by the indexing/retrieval code.
MANIFOLD_DB_URL=postgresql://manifold:manifold@localhost:5433/manifold

# Anthropic API key is only needed for Phase 5 (grounded generation) onward.
# ANTHROPIC_API_KEY=sk-ant-...

# Dragos WorldView API (optional, licensed) — only needed to fetch the local-only Dragos
# source via `python -m manifold.ingest.dragos_fetch`. Never committed. Use ONE of:
#   (a) an API Token + Secret pair (portal: Settings -> API Access):
# DRAGOS_API_TOKEN=...
# DRAGOS_API_SECRET=...
#   (b) or a single NPE / bearer token (sent as the Authorization header):
# DRAGOS_NPE_TOKEN=...
# Optional: restrict the pull to products/indicators carrying this sector tag.
# DRAGOS_PERSPECTIVE=Manufacturing
